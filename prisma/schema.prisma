generator client {
  provider = "prisma-client-js"
  // output   = "../node_modules/.prisma/client" // DELETE TO FIX BUG
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model acoes {
  id            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome          String       @db.VarChar(255)
  aplicativo_id String       @db.Uuid
  path          String?      @db.VarChar(255)
  method        String?      @db.VarChar(7)
  createdat     DateTime     @default(now()) @db.Timestamp(6)
  updatedat     DateTime?    @db.Timestamp(6)
  aplicativos   aplicativos  @relation(fields: [aplicativo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permissoes    permissoes[]

  @@unique([aplicativo_id, path, method], map: "unique_acao")
}

model aplicativos {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome       String       @unique @db.VarChar(255)
  slug       String       @unique @db.VarChar(255)
  createdat  DateTime     @default(now()) @db.Timestamp(6)
  updatedat  DateTime?    @db.Timestamp(6)
  acoes      acoes[]
  permissoes permissoes[]
}

model entidades {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome       String       @db.VarChar(255)
  cod        String       @unique @db.VarChar(8)
  doc        String?      @unique @db.VarChar(14)
  createdat  DateTime     @default(now()) @db.Timestamp(6)
  updatedat  DateTime?    @db.Timestamp(6)
  permissoes permissoes[]
}

model permissoes {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id    String      @db.Uuid
  aplicativo_id String      @db.Uuid
  entidade_id   String      @db.Uuid
  acao_id       String      @db.Uuid
  createdat     DateTime    @default(now()) @db.Timestamp(6)
  updatedat     DateTime?   @db.Timestamp(6)
  acoes         acoes       @relation(fields: [acao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  aplicativos   aplicativos @relation(fields: [aplicativo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entidades     entidades   @relation(fields: [entidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios      usuarios    @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, aplicativo_id, entidade_id, acao_id], map: "unique_usuario_permission")
}

model usuarios {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome       String       @db.VarChar(255)
  login      String       @unique @db.VarChar(255)
  email      String       @unique @db.VarChar(255)
  doc        String?      @unique @db.VarChar(14)
  pass       String       @db.VarChar(255)
  token      String?      @db.VarChar(255)
  createdat  DateTime     @default(now()) @db.Timestamp(6)
  updatedat  DateTime?    @db.Timestamp(6)
  permissoes permissoes[]
}
