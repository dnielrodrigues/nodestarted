{
  // Code Action kinds to be run on save.
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },

  // identations
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.tabSize": 2
  },

